---
import BaseLayout from '../layouts/BaseLayout.astro';

const rawBase = import.meta.env.BASE_URL || "";
const base = rawBase.replace(/\/$/, "");
const url = (p: string) => `${base}${p.startsWith('/') ? p : '/' + p}`;
---

<BaseLayout
  title="ATHARVA SHARMA — Male Fashion & Editorial Runway Model Portfolio"
  description="Official portfolio of Atharva Sharma, Indian male editorial and runway fashion model based in Udaipur, India. 6'1&quot; (186cm), high luxury couture, runway poise, and commercial campaign bookings."
  keywords="Atharva Sharma, male model India, Indian runway model, fashion model Udaipur, high fashion editorial, menswear model, 6'1 model"
  ogImage="assets/images/atharva-studio-bw-stool.png"
  lcpPreloadImage="assets/images/atharva-studio-bw-stool.webp"
>
<!-- ==================== HERO SECTION (Brutalist Poster Composition) ==================== -->
<section class="relative w-full min-h-[92vh] sm:min-h-screen bg-canvas-warm flex flex-col justify-between pt-4 sm:pt-6 pb-6 sm:pb-8 px-4 sm:px-8 max-w-[1780px] mx-auto overflow-hidden" id="hero">
  <!-- Top Metadata Header Strip -->
  <div class="anim-fade-up flex items-center justify-between font-mono text-[10px] xs:text-[11px] sm:text-xs tracking-widest uppercase pb-3 border-b border-grid-border relative z-20 gap-2">
    <div class="flex flex-wrap items-center gap-x-2.5 sm:gap-x-5 gap-y-1">
      <span class="font-bold text-editorial-ink">UDAIPUR, IN</span>
      <span class="text-editorial-gray">|</span>
      <span class="text-editorial-ink">RUNWAY &amp; EDITORIAL</span>
      <span class="text-editorial-gray hidden md:inline">|</span>
      <span class="text-editorial-red font-bold hidden md:inline">● AVAILABLE 2026</span>
    </div>
    <div class="flex items-center gap-2.5 sm:gap-4 flex-shrink-0">
      <span class="font-semibold text-editorial-ink tracking-widest hidden sm:inline">PORTFOLIO NO. 01</span>
      <!-- Red Accent Block as specified in poster style -->
      <div aria-hidden="true" class="w-8 h-8 sm:w-11 sm:h-11 bg-editorial-red flex-shrink-0 shadow-sm flex items-center justify-center text-white font-mono text-[10px] font-bold">
        '26
      </div>
    </div>
  </div>

  <!-- Center Poster Stage: Layered Huge Red Typography + High-Fashion Central Frame -->
  <div class="relative flex-1 flex flex-col justify-center items-center my-4 sm:my-6 py-1">
    <!-- Oversized Red Title 1: "ATHARVA" (Live Typographic Bleed) -->
    <div class="anim-fade-up w-full text-center relative z-20 pointer-events-none select-none">
      <h1 class="hero-type-bleed font-display text-editorial-red uppercase whitespace-nowrap">
        ATHARVA
      </h1>
    </div>

    <!-- Center Sharp Editorial Frame: Real Photo atharva-studio-bw-stool.png (Optimized WebP + Eager LCP) -->
    <div class="anim-hero-frame relative w-[88%] sm:w-[54%] md:w-[42%] lg:w-[34%] max-w-[480px] mx-auto z-10 shadow-2xl bg-canvas-sheet overflow-hidden border-2 border-editorial-ink aspect-[3/4] -my-3 sm:-my-6">
      <picture class="w-full h-full block">
        <source srcset={url("/assets/images/atharva-studio-bw-stool.webp")} type="image/webp" />
        <img
          alt="Atharva Sharma studio seated portrait in dark structured jacket"
          class="w-full h-full object-cover"
          src={url("/assets/images/atharva-studio-bw-stool.png")}
          width="1024"
          height="1365"
          loading="eager"
          decoding="sync"
          fetchpriority="high"
          style="object-position: center 15%;"
        />
      </picture>
      <!-- Editorial Film Grain & Caption Badge -->
      <div class="absolute inset-0 bg-grain pointer-events-none opacity-30 mix-blend-multiply"></div>
      <div class="absolute bottom-2.5 left-2.5 bg-editorial-ink/90 text-white font-mono text-[9px] sm:text-[10px] tracking-widest uppercase px-2 py-0.5 backdrop-blur-xs flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 bg-editorial-red inline-block"></span>
        <span class="">FIG. 01 // STUDIO SEATED PORTRAIT</span>
      </div>
      <div class="absolute top-2.5 right-2.5 bg-canvas-warm/95 text-editorial-ink font-mono text-[9px] tracking-widest uppercase px-1.5 py-0.5 border border-editorial-ink">
        REPRESENTATION DIRECT
      </div>
    </div>

    <!-- Oversized Red Title 2: "SHARMA" (Layered below framed portrait) -->
    <div class="anim-fade-up w-full text-center relative z-20 pointer-events-none select-none">
      <h1 class="hero-type-bleed font-display text-editorial-red uppercase whitespace-nowrap">
        SHARMA
      </h1>
    </div>

    <!-- Micro-Labels Layer (Distributed Editorial Poster Metadata) -->
    <div class="absolute inset-0 pointer-events-none z-30 hidden sm:flex flex-col justify-between py-5 px-2">
      <div class="flex justify-between items-start font-mono text-[11px] tracking-widest uppercase text-editorial-ink">
        <div class="max-w-[210px] leading-relaxed bg-canvas-warm/80 p-1.5 backdrop-blur-xs border border-grid-border">
          <span class="text-editorial-red font-bold">● SS26 COMP-BOOK</span><br>
          MALE RUNWAY &amp; EDITORIAL<br>
          DIRECT CASTING BOARD
        </div>
        <div class="text-right bg-canvas-warm/80 p-1.5 backdrop-blur-xs border border-grid-border">
          <span class="text-editorial-red font-bold">SPECIMEN NO. 081</span><br>
          HEIGHT: 6'1" / 186CM<br>
          <span class="text-editorial-gray">LOCATION: UDAIPUR / IN</span>
        </div>
      </div>
      <div class="flex justify-between items-end font-mono text-[11px] tracking-widest uppercase text-editorial-ink">
        <div class="bg-canvas-warm/80 p-1.5 backdrop-blur-xs border border-grid-border">
          <span class="text-editorial-gray">STYLE:</span> EDITORIAL BRUTALISM<br>
          CURATED ARCHIVE: 08 LOOKS
        </div>
        <div class="text-right bg-canvas-warm/80 p-1.5 backdrop-blur-xs border border-grid-border">
          <span class="">SCROLL FOR ARCHIVE</span><br>
          <span class="text-editorial-red font-bold">DISPATCH 01 ↓</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Caption Row & Monospace Details -->
  <div class="w-full border-t border-grid-border pt-3.5 flex flex-wrap items-center justify-between font-mono text-[10px] xs:text-[11px] sm:text-xs tracking-widest uppercase text-editorial-ink z-20 gap-2">
    <div class="flex items-center gap-2 sm:gap-3">
      <span class="font-bold tracking-wider text-editorial-red">MAIN BOOK</span>
      <span class="w-5 sm:w-8 h-[1px] bg-editorial-ink/30 inline-block"></span>
      <span class="text-editorial-gray text-[10px] xs:text-[11px] sm:text-xs">HIGH FASHION / SARTORIAL / COMMISSIONS</span>
    </div>
    <div class="flex items-center gap-4 sm:gap-6">
      <span class="hidden md:inline text-editorial-gray">INDEX REF: ATH-2026-HQ</span>
      <span class="font-semibold">EST. 2026</span>
    </div>
  </div>
</section>

<!-- ==================== METRICS & SPEC TICKER BAR ==================== -->
<aside class="w-full bg-editorial-ink text-canvas-warm border-y border-editorial-ink overflow-hidden py-3 font-mono text-xs uppercase tracking-widest relative z-30 select-none" id="metrics">
  <div class="animate-ticker flex items-center">
    <div class="flex items-center gap-8 px-4">
      <span class="flex items-center gap-2"><span class="w-2 h-2 bg-editorial-red"></span>HEIGHT: 6'1" / 186CM</span>
      <span class="text-editorial-gray">/</span>
      <span class="">CHEST: 38" / 96CM</span>
      <span class="text-editorial-gray">/</span>
      <span class="">WAIST: 30" / 76CM</span>
      <span class="text-editorial-gray">/</span>
      <span class="">SHOES: 43 EU / 10 US</span>
      <span class="text-editorial-gray">/</span>
      <span class="">HAIR: DARK BROWN</span>
      <span class="text-editorial-gray">/</span>
      <span class="">EYES: HAZEL</span>
      <span class="text-editorial-gray">/</span>
      <span class="text-editorial-red font-bold">REPRESENTATION: DIRECT BOARD</span>
      <span class="text-editorial-gray">/</span>
      <span class="">STATUS: ACCEPTING SS26 COMMISSIONS</span>
      <span class="text-editorial-gray">/</span>
    </div>
    <!-- Cloned ticker content for seamless endless loop -->
    <div class="flex items-center gap-8 px-4">
      <span class="flex items-center gap-2"><span class="w-2 h-2 bg-editorial-red"></span>HEIGHT: 6'1" / 186CM</span>
      <span class="text-editorial-gray">/</span>
      <span class="">CHEST: 38" / 96CM</span>
      <span class="text-editorial-gray">/</span>
      <span class="">WAIST: 30" / 76CM</span>
      <span class="text-editorial-gray">/</span>
      <span class="">SHOES: 43 EU / 10 US</span>
      <span class="text-editorial-gray">/</span>
      <span class="">HAIR: DARK BROWN</span>
      <span class="text-editorial-gray">/</span>
      <span class="">EYES: HAZEL</span>
      <span class="text-editorial-gray">/</span>
      <span class="text-editorial-red font-bold">REPRESENTATION: DIRECT BOARD</span>
      <span class="text-editorial-gray">/</span>
      <span class="">STATUS: ACCEPTING SS26 COMMISSIONS</span>
      <span class="text-editorial-gray">/</span>
    </div>
  </div>
</aside>

<!-- ==================== CLIENT / EDITORIAL DISCIPLINES BADGES ==================== -->
<section class="w-full bg-canvas-alt border-b border-grid-border py-6 px-4 sm:px-8 max-w-[1780px] mx-auto">
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 font-mono text-xs uppercase tracking-wider">
    <div class="flex items-center gap-2 text-editorial-gray font-semibold">
      <span class="material-symbols-outlined text-base text-editorial-red">category</span>
      <span class="">CORE DISCIPLINES &amp; SPECIALIZATIONS:</span>
    </div>
    <div class="flex flex-wrap gap-2 sm:gap-3">
      <span class="px-3 py-1 bg-canvas-warm border border-editorial-ink/30 text-editorial-ink font-mono font-medium hover:border-editorial-red transition-colors">
        RUNWAY
      </span>
      <span class="px-3 py-1 bg-editorial-red text-white font-mono font-semibold">
        HIGH LUXURY EDITORIAL
      </span>
      <span class="px-3 py-1 bg-canvas-warm border border-editorial-ink/30 text-editorial-ink font-mono font-medium hover:border-editorial-red transition-colors">
        COMMERCIAL READY-TO-WEAR
      </span>
      <span class="px-3 py-1 bg-canvas-warm border border-editorial-ink/30 text-editorial-ink font-mono font-medium hover:border-editorial-red transition-colors">
        EQUESTRIAN &amp; MOVEMENT
      </span>
      <span class="px-3 py-1 bg-canvas-warm border border-editorial-ink/30 text-editorial-ink font-mono font-medium hover:border-editorial-red transition-colors">
        HERITAGE COUTURE
      </span>
    </div>
  </div>
</section>

<!-- ==================== CURATED LOOKS & EDITORIAL ARCHIVE GRID ==================== -->
<section class="cv-auto w-full bg-canvas-warm px-4 sm:px-8 max-w-[1780px] mx-auto py-10" id="portfolio">
  <!-- Section Header Bar -->
  <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 pb-4 border-b-2 border-editorial-ink gap-4">
    <div>
      <div class="font-mono text-xs tracking-widest uppercase text-editorial-red mb-1.5 font-bold flex items-center gap-2">
        <span class="w-2 h-2 bg-editorial-red inline-block"></span>
        <span class="">CURATED ARCHIVE // 08 SELECTED LOOKS // SS26 DISPATCH</span>
      </div>
      <h2 class="font-display text-4xl sm:text-6xl md:text-7xl uppercase tracking-tight text-editorial-ink leading-none">
        PORTFOLIO ARCHIVE
      </h2>
    </div>
    <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-4 font-mono text-xs uppercase tracking-wider">
      <span class="text-editorial-gray flex items-center gap-1.5 text-[11px]">
        <span class="w-1.5 h-1.5 rounded-full bg-editorial-red animate-pulse"></span>
        <span class="">TAP / HOVER TO REVEAL COLOR</span>
      </span>
      <a href={url("/portfolio")} class="inline-flex items-center justify-center gap-2 bg-editorial-ink text-white px-4 py-2.5 hover:bg-editorial-red transition-colors font-bold text-[11px] tracking-widest min-h-[44px]">
        <span class="">VIEW COMPLETE PORTFOLIO</span>
        <span class="material-symbols-outlined text-xs">arrow_forward</span>
      </a>
    </div>
  </div>

  <!-- Compact 4-Column Editorial Lookbook Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
    <!-- Look 01 -->
    <article class="group cursor-pointer bg-canvas-sheet border-2 border-editorial-ink p-2 flex flex-col justify-between shadow-sm hover:border-editorial-red transition-colors">
      <div class="relative overflow-hidden aspect-[3/4] bg-canvas-alt border border-editorial-ink">
        <picture class="w-full h-full block">
          <source srcset={url("/assets/images/atharva-horse-beach.webp")} type="image/webp" />
          <img
            alt="Atharva Sharma on white horse at the beach in white linen"
            class="curated-photo w-full h-full object-cover object-top"
            src={url("/assets/images/atharva-horse-beach.jpg")}
            width="1169"
            height="1759"
            loading="lazy"
            decoding="async"
          />
        </picture>
        <div class="absolute top-2 left-2 bg-editorial-ink text-white font-mono text-[9px] tracking-widest uppercase px-1.5 py-0.5">
          01 // GOA
        </div>
        <div class="absolute bottom-2 right-2 bg-canvas-warm/95 text-editorial-ink font-mono text-[9px] tracking-wider uppercase px-1.5 py-0.5 border border-editorial-ink backdrop-blur-xs">
          SS26
        </div>
      </div>
      <div class="pt-2.5 pb-1">
        <div class="flex justify-between items-baseline font-mono text-[10px] tracking-widest uppercase">
          <span class="font-bold text-editorial-ink group-hover:text-editorial-red transition-colors">LOOK 01</span>
          <span class="text-editorial-gray">EQUESTRIAN</span>
        </div>
        <div class="font-display text-base uppercase text-editorial-ink mt-0.5 truncate">Equestrian Resort Linen</div>
        <div class="font-mono text-[9px] text-editorial-gray tracking-wide mt-1 truncate">Draped White Organic Linen</div>
      </div>
    </article>

    <!-- Look 02 -->
    <article class="group cursor-pointer bg-canvas-sheet border-2 border-editorial-ink p-2 flex flex-col justify-between shadow-sm hover:border-editorial-red transition-colors">
      <div class="relative overflow-hidden aspect-[3/4] bg-canvas-alt border border-editorial-ink">
        <picture class="w-full h-full block">
          <source srcset={url("/assets/images/atharva-kurta-palace-night.webp")} type="image/webp" />
          <img
            alt="Atharva Sharma in black embroidered velvet kurta at illuminated fountain"
            class="curated-photo w-full h-full object-cover object-top"
            src={url("/assets/images/atharva-kurta-palace-night.jpg")}
            width="943"
            height="1600"
            loading="lazy"
            decoding="async"
          />
        </picture>
        <div class="absolute top-2 left-2 bg-editorial-ink text-white font-mono text-[9px] tracking-widest uppercase px-1.5 py-0.5">
          02 // PALACE
        </div>
        <div class="absolute bottom-2 right-2 bg-canvas-warm/95 text-editorial-ink font-mono text-[9px] tracking-wider uppercase px-1.5 py-0.5 border border-editorial-ink backdrop-blur-xs">
          COUTURE
        </div>
      </div>
      <div class="pt-2.5 pb-1">
        <div class="flex justify-between items-baseline font-mono text-[10px] tracking-widest uppercase">
          <span class="font-bold text-editorial-ink group-hover:text-editorial-red transition-colors">LOOK 02</span>
          <span class="text-editorial-gray">HERITAGE</span>
        </div>
        <div class="font-display text-base uppercase text-editorial-ink mt-0.5 truncate">Velvet Embroidered Kurta</div>
        <div class="font-mono text-[9px] text-editorial-gray tracking-wide mt-1 truncate">Bespoke Zardozi Needlework</div>
      </div>
    </article>

    <!-- Look 03 -->
    <article class="group cursor-pointer bg-canvas-sheet border-2 border-editorial-ink p-2 flex flex-col justify-between shadow-sm hover:border-editorial-red transition-colors">
      <div class="relative overflow-hidden aspect-[3/4] bg-canvas-alt border border-editorial-ink">
        <picture class="w-full h-full block">
          <source srcset={url("/assets/images/atharva-desert-jeep-bw.webp")} type="image/webp" />
          <img
            alt="Atharva Sharma in jeep sunroof open desert landscape"
            class="curated-photo w-full h-full object-cover object-center"
            src={url("/assets/images/atharva-desert-jeep-bw.jpg")}
            width="1262"
            height="1246"
            loading="lazy"
            decoding="async"
          />
        </picture>
        <div class="absolute top-2 left-2 bg-editorial-ink text-white font-mono text-[9px] tracking-widest uppercase px-1.5 py-0.5">
          03 // THAR
        </div>
        <div class="absolute bottom-2 right-2 bg-canvas-warm/95 text-editorial-ink font-mono text-[9px] tracking-wider uppercase px-1.5 py-0.5 border border-editorial-ink backdrop-blur-xs">
          EXPEDITION
        </div>
      </div>
      <div class="pt-2.5 pb-1">
        <div class="flex justify-between items-baseline font-mono text-[10px] tracking-widest uppercase">
          <span class="font-bold text-editorial-ink group-hover:text-editorial-red transition-colors">LOOK 03</span>
          <span class="text-editorial-gray">OUTDOOR</span>
        </div>
        <div class="font-display text-base uppercase text-editorial-ink mt-0.5 truncate">Jeep Safari Open Dune</div>
        <div class="font-mono text-[9px] text-editorial-gray tracking-wide mt-1 truncate">Monochrome Outdoor Silhouette</div>
      </div>
    </article>

    <!-- Look 04 -->
    <article class="group cursor-pointer bg-canvas-sheet border-2 border-editorial-ink p-2 flex flex-col justify-between shadow-sm hover:border-editorial-red transition-colors">
      <div class="relative overflow-hidden aspect-[3/4] bg-canvas-alt border border-editorial-ink">
        <picture class="w-full h-full block">
          <source srcset={url("/assets/images/atharva-cafe-beanie.webp")} type="image/webp" />
          <img
            alt="Atharva Sharma knit sweater vest tie and beanie at cafe terrace"
            class="curated-photo w-full h-full object-cover object-center"
            src={url("/assets/images/atharva-cafe-beanie.jpg")}
            width="1024"
            height="1365"
            loading="lazy"
            decoding="async"
          />
        </picture>
        <div class="absolute top-2 left-2 bg-editorial-ink text-white font-mono text-[9px] tracking-widest uppercase px-1.5 py-0.5">
          04 // URBAN
        </div>
        <div class="absolute bottom-2 right-2 bg-canvas-warm/95 text-editorial-ink font-mono text-[9px] tracking-wider uppercase px-1.5 py-0.5 border border-editorial-ink backdrop-blur-xs">
          AW READY
        </div>
      </div>
      <div class="pt-2.5 pb-1">
        <div class="flex justify-between items-baseline font-mono text-[10px] tracking-widest uppercase">
          <span class="font-bold text-editorial-ink group-hover:text-editorial-red transition-colors">LOOK 04</span>
          <span class="text-editorial-gray">SARTORIAL</span>
        </div>
        <div class="font-display text-base uppercase text-editorial-ink mt-0.5 truncate">Vintage Cafe &amp; Beanie</div>
        <div class="font-mono text-[9px] text-editorial-gray tracking-wide mt-1 truncate">Collegiate Knitwear &amp; Silk Tie</div>
      </div>
    </article>

    <!-- Look 05 -->
    <article class="group cursor-pointer bg-canvas-sheet border-2 border-editorial-ink p-2 flex flex-col justify-between shadow-sm hover:border-editorial-red transition-colors">
      <div class="relative overflow-hidden aspect-[3/4] bg-canvas-alt border border-editorial-ink">
        <picture class="w-full h-full block">
          <source srcset={url("/assets/images/atharva-lake-backpack.webp")} type="image/webp" />
          <img
            alt="Atharva Sharma backpack overlooking Udaipur lake ghats"
            class="curated-photo w-full h-full object-cover object-top"
            src={url("/assets/images/atharva-lake-backpack.jpg")}
            width="1200"
            height="1600"
            loading="lazy"
            decoding="async"
          />
        </picture>
        <div class="absolute top-2 left-2 bg-editorial-ink text-white font-mono text-[9px] tracking-widest uppercase px-1.5 py-0.5">
          05 // GHAT
        </div>
        <div class="absolute bottom-2 right-2 bg-canvas-warm/95 text-editorial-ink font-mono text-[9px] tracking-wider uppercase px-1.5 py-0.5 border border-editorial-ink backdrop-blur-xs">
          DAYLIGHT
        </div>
      </div>
      <div class="pt-2.5 pb-1">
        <div class="flex justify-between items-baseline font-mono text-[10px] tracking-widest uppercase">
          <span class="font-bold text-editorial-ink group-hover:text-editorial-red transition-colors">LOOK 05</span>
          <span class="text-editorial-gray">DAYLIGHT</span>
        </div>
        <div class="font-display text-base uppercase text-editorial-ink mt-0.5 truncate">Lake Technical Expedition</div>
        <div class="font-mono text-[9px] text-editorial-gray tracking-wide mt-1 truncate">High Mobility Utility Wear</div>
      </div>
    </article>

    <!-- Look 06 -->
    <article class="group cursor-pointer bg-canvas-sheet border-2 border-editorial-ink p-2 flex flex-col justify-between shadow-sm hover:border-editorial-red transition-colors">
      <div class="relative overflow-hidden aspect-[3/4] bg-canvas-alt border border-editorial-ink">
        <picture class="w-full h-full block">
          <source srcset={url("/assets/images/atharva-beach-night-linen.webp")} type="image/webp" />
          <img
            alt="Atharva Sharma white linen shirt and glasses on night beach"
            class="curated-photo w-full h-full object-cover object-top"
            src={url("/assets/images/atharva-beach-night-linen.jpg")}
            width="1028"
            height="1519"
            loading="lazy"
            decoding="async"
          />
        </picture>
        <div class="absolute top-2 left-2 bg-editorial-ink text-white font-mono text-[9px] tracking-widest uppercase px-1.5 py-0.5">
          06 // NOCTURNE
        </div>
        <div class="absolute bottom-2 right-2 bg-canvas-warm/95 text-editorial-ink font-mono text-[9px] tracking-wider uppercase px-1.5 py-0.5 border border-editorial-ink backdrop-blur-xs">
          SEASIDE
        </div>
      </div>
      <div class="pt-2.5 pb-1">
        <div class="flex justify-between items-baseline font-mono text-[10px] tracking-widest uppercase">
          <span class="font-bold text-editorial-ink group-hover:text-editorial-red transition-colors">LOOK 06</span>
          <span class="text-editorial-gray">COASTAL</span>
        </div>
        <div class="font-display text-base uppercase text-editorial-ink mt-0.5 truncate">Night Coastal Relaxed Linen</div>
        <div class="font-mono text-[9px] text-editorial-gray tracking-wide mt-1 truncate">Crisp White &amp; Wire-Rim Eyewear</div>
      </div>
    </article>

    <!-- Look 07 -->
    <article class="group cursor-pointer bg-canvas-sheet border-2 border-editorial-ink p-2 flex flex-col justify-between shadow-sm hover:border-editorial-red transition-colors">
