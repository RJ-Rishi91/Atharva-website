---
import BaseLayout from '../layouts/BaseLayout.astro';

const rawBase = import.meta.env.BASE_URL || "";
const base = rawBase.replace(/\/$/, "");
const url = (p: string) => `${base}${p.startsWith('/') ? p : '/' + p}`;
---

<BaseLayout
  title="404 NOT FOUND — Atharva Sharma // Unindexed Specimen"
  description="Requested editorial document or portfolio look could not be located in the Atharva Sharma archive directory."
  keywords="404, not found, Atharva Sharma portfolio"
  ogImage="assets/images/atharva-studio-bw-stool.png"
>
<section class="w-full bg-canvas-warm px-4 sm:px-8 py-12 sm:py-20 flex items-center justify-center min-h-[70vh]">
  <div class="max-w-3xl w-full mx-auto border-2 border-editorial-ink p-6 sm:p-12 bg-white shadow-xl">
    
    <div class="flex items-center gap-2 mb-3 font-mono text-xs text-editorial-red font-bold">
      <span class="w-2.5 h-2.5 bg-editorial-red inline-block"></span>
      <span>ERROR: 404 // UNINDEXED DIRECTORY SPECIMEN</span>
    </div>

    <h1 class="font-display text-4xl sm:text-6xl lg:text-7xl text-editorial-ink uppercase leading-none tracking-tight mb-4">
      DISPATCH NOT FOUND
    </h1>

    <div class="w-16 h-1 bg-editorial-red mb-4"></div>

    <p class="font-sans text-sm sm:text-base text-editorial-gray leading-relaxed mb-8">
      The requested route or portfolio look is unavailable, moved to vault archives, or has not yet been indexed in the live system.
    </p>

    <div class="border-t border-grid-border pt-6">
      <span class="font-mono text-xs text-editorial-ink uppercase font-bold tracking-widest block mb-4">
        PRIMARY EDITORIAL DIRECTORIES:
      </span>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 font-mono text-xs">
        <a href={url("/")} class="p-3 bg-canvas-sheet border border-grid-border text-editorial-ink hover:bg-editorial-ink hover:text-white transition-colors text-center font-bold uppercase min-h-[44px] flex items-center justify-center">
          01. HOME
        </a>
        <a href={url("/portfolio")} class="p-3 bg-canvas-sheet border border-grid-border text-editorial-ink hover:bg-editorial-ink hover:text-white transition-colors text-center font-bold uppercase min-h-[44px] flex items-center justify-center">
          02. PORTFOLIO
        </a>
        <a href={url("/stats")} class="p-3 bg-canvas-sheet border border-grid-border text-editorial-ink hover:bg-editorial-ink hover:text-white transition-colors text-center font-bold uppercase min-h-[44px] flex items-center justify-center">
          03. STATS
        </a>
        <a href={url("/about")} class="p-3 bg-canvas-sheet border border-grid-border text-editorial-ink hover:bg-editorial-ink hover:text-white transition-colors text-center font-bold uppercase min-h-[44px] flex items-center justify-center">
          04. ABOUT
        </a>
        <a href={url("/journal")} class="p-3 bg-canvas-sheet border border-grid-border text-editorial-ink hover:bg-editorial-ink hover:text-white transition-colors text-center font-bold uppercase min-h-[44px] flex items-center justify-center">
          05. JOURNAL
        </a>
        <a href={url("/digitals")} class="p-3 bg-canvas-sheet border border-grid-border text-editorial-ink hover:bg-editorial-ink hover:text-white transition-colors text-center font-bold uppercase min-h-[44px] flex items-center justify-center">
          06. DIGITALS
        </a>
        <a href={url("/comp-card")} class="p-3 bg-canvas-sheet border border-grid-border text-editorial-ink hover:bg-editorial-ink hover:text-white transition-colors text-center font-bold uppercase min-h-[44px] flex items-center justify-center">
          07. COMP-CARD
        </a>
        <a href={url("/contact")} class="p-3 bg-editorial-ink text-white hover:bg-editorial-red transition-colors text-center font-bold uppercase min-h-[44px] flex items-center justify-center">
          08. CONTACT
        </a>
      </div>
    </div>

  </div>
</section>
</BaseLayout>
