---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const rawBase = import.meta.env.BASE_URL || "";
const base = rawBase.replace(/\/$/, "");
const url = (p: string) => `${base}${p.startsWith('/') ? p : '/' + p}`;

const allArticles = await getCollection('journal');
const sortedArticles = allArticles.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="EDITORIAL JOURNAL — Atharva Sharma // Dispatches & Essays"
  description="Personal repository of model Atharva Sharma documenting runway mechanics, high-fashion campaigns, and the evolving language of contemporary South Asian menswear."
  keywords="Atharva Sharma journal, modeling blog, runway technique, fashion editorial essays, Indian menswear, modeling diary"
  ogImage="assets/images/atharva-studio-bw-stool.png"
>
  <div class="flex flex-col w-full">
    <!-- Sub-Header / Page Indicator Strip -->
    <section class="w-full bg-canvas-alt px-4 sm:px-8 lg:px-12 py-3 border-b border-grid-border">
      <div class="max-w-[1780px] mx-auto flex flex-wrap items-center justify-between gap-y-2">
        <div class="flex items-center gap-3">
          <span class="w-2 h-2 bg-editorial-red inline-block"></span>
          <span class="font-mono text-xs text-editorial-ink font-bold uppercase tracking-widest">VOL. 04 // ISSUE 08</span>
          <span class="text-editorial-gray text-xs">•</span>
          <span class="font-mono text-xs text-editorial-gray tracking-widest uppercase">DISPATCHES &amp; ESSAYS</span>
        </div>
        <div class="flex items-center gap-4 font-mono text-xs text-editorial-gray">
          <span>BOARD: DIRECT MALE RUNWAY</span>
          <span class="hidden sm:inline">LOC: UDAIPUR / MUMBAI / GLOBAL</span>
          <span class="text-editorial-red font-bold">STATUS: AVAILABLE</span>
        </div>
      </div>
    </section>

    <!-- Title & Editorial Overline Hero Banner -->
    <section class="w-full bg-canvas-warm px-4 sm:px-8 lg:px-12 pt-12 pb-8">
      <div class="max-w-[1780px] mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 items-end">
        <div class="lg:col-span-8 flex flex-col gap-3">
          <div class="flex items-center gap-2">
            <span class="font-mono text-xs text-editorial-red uppercase tracking-widest font-bold">[ 06 // ARCHIVE ]</span>
            <span class="w-12 h-px bg-editorial-red inline-block"></span>
            <span class="font-mono text-xs text-editorial-gray tracking-widest uppercase">WRITTEN &amp; CURATED BY ATHARVA SHARMA</span>
          </div>
          <h1 class="font-display text-4xl sm:text-6xl lg:text-7xl uppercase text-editorial-ink tracking-tight leading-none m-0">
            EDITORIAL JOURNAL <span class="text-editorial-red">//</span> DISPATCHES
          </h1>
        </div>
        <div class="lg:col-span-4 flex flex-col justify-end">
          <p class="font-sans text-sm text-editorial-gray max-w-md leading-relaxed">
            A personal repository documenting the physical discipline of runway mechanics, high-fashion campaign dialogues, raw polaroids, and the evolving language of contemporary South Asian and global menswear.
          </p>
        </div>
      </div>

      <!-- Category Filter Bar (Smooth horizontal swipe on mobile, clean bar on desktop) -->
      <div class="max-w-[1780px] mx-auto mt-8 sm:mt-10 bg-canvas-sheet p-2 flex items-center gap-2 overflow-x-auto no-scrollbar flex-nowrap -mx-4 px-4 sm:mx-0 sm:px-2" id="filter-container">
        <button class="journal-filter-btn px-4 py-2.5 font-mono text-xs tracking-widest uppercase bg-editorial-ink text-white transition-colors duration-150 whitespace-nowrap flex-shrink-0 min-h-[40px]" data-filter="all">
          [ ALL ({sortedArticles.length}) ]
        </button>
        <button class="journal-filter-btn px-4 py-2.5 font-mono text-xs tracking-widest uppercase bg-canvas-warm text-editorial-ink hover:bg-editorial-ink hover:text-white transition-colors duration-150 whitespace-nowrap flex-shrink-0 min-h-[40px]" data-filter="CRAFT & TECHNIQUE">
          CRAFT &amp; TECHNIQUE
        </button>
        <button class="journal-filter-btn px-4 py-2.5 font-mono text-xs tracking-widest uppercase bg-canvas-warm text-editorial-ink hover:bg-editorial-ink hover:text-white transition-colors duration-150 whitespace-nowrap flex-shrink-0 min-h-[40px]" data-filter="EDITORIAL DISPATCH">
          EDITORIAL DISPATCH
        </button>
        <button class="journal-filter-btn px-4 py-2.5 font-mono text-xs tracking-widest uppercase bg-canvas-warm text-editorial-ink hover:bg-editorial-ink hover:text-white transition-colors duration-150 whitespace-nowrap flex-shrink-0 min-h-[40px]" data-filter="ON LOCATION">
          ON LOCATION
        </button>
        <button class="journal-filter-btn px-4 py-2.5 font-mono text-xs tracking-widest uppercase bg-canvas-warm text-editorial-ink hover:bg-editorial-ink hover:text-white transition-colors duration-150 whitespace-nowrap flex-shrink-0 min-h-[40px]" data-filter="INDUSTRY INSIGHTS">
          INDUSTRY INSIGHTS
        </button>
        <button class="journal-filter-btn px-4 py-2.5 font-mono text-xs tracking-widest uppercase bg-canvas-warm text-editorial-ink hover:bg-editorial-ink hover:text-white transition-colors duration-150 whitespace-nowrap flex-shrink-0 min-h-[40px]" data-filter="CAMPAIGN NOTES">
          CAMPAIGN NOTES
        </button>
        <button class="journal-filter-btn px-4 py-2.5 font-mono text-xs tracking-widest uppercase bg-canvas-warm text-editorial-ink hover:bg-editorial-ink hover:text-white transition-colors duration-150 whitespace-nowrap flex-shrink-0 min-h-[40px]" data-filter="TRAVEL LOG">
          TRAVEL LOG
        </button>
        <button class="journal-filter-btn px-4 py-2.5 font-mono text-xs tracking-widest uppercase bg-canvas-warm text-editorial-ink hover:bg-editorial-ink hover:text-white transition-colors duration-150 whitespace-nowrap flex-shrink-0 min-h-[40px]" data-filter="STYLE COMMENTARY">
          STYLE COMMENTARY
        </button>
      </div>
    </section>

    <!-- Articles Grid Section -->
    <section class="w-full px-4 sm:px-8 lg:px-12 py-12 bg-canvas-warm">
      <div class="max-w-[1780px] mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="articles-grid">
        {sortedArticles.map((article) => (
          <article
            class="journal-card group flex flex-col bg-canvas-alt border border-grid-border hover:border-editorial-red transition-all duration-300 shadow-sm"
            data-category={article.data.category}
          >
            <!-- Card Image -->
            <a href={url(`/journal/${article.slug}`)} class="relative w-full aspect-[16/10] overflow-hidden bg-canvas-sheet block">
              <img
                src={url(article.data.heroImage)}
                alt={article.data.heroImageAlt}
                class="w-full h-full object-cover grayscale contrast-108 transition-all duration-700 ease-out group-hover:grayscale-0 group-hover:scale-105"
                style={`object-position: ${article.data.focusPosition};`}
              />
              <div class="absolute top-3 left-3 bg-editorial-ink/90 text-white font-mono text-[10px] uppercase tracking-widest px-2.5 py-1">
                {article.data.dispatchId}
              </div>
            </a>

            <!-- Card Body -->
            <div class="p-6 flex flex-col flex-grow justify-between gap-4">
              <div class="flex flex-col gap-2.5">
                <div class="flex items-center justify-between font-mono text-[11px] text-editorial-gray uppercase tracking-wider">
                  <span class="text-editorial-red font-bold">{article.data.category}</span>
                  <span>{article.data.readTime}</span>
                </div>
                <h2 class="font-display text-2xl uppercase text-editorial-ink leading-tight group-hover:text-editorial-red transition-colors">
                  <a href={url(`/journal/${article.slug}`)}>
                    {article.data.title}
                  </a>
                </h2>
                <p class="font-sans text-xs text-editorial-gray leading-relaxed line-clamp-3">
                  {article.data.description}
                </p>
              </div>

              <!-- Card Footer -->
              <div class="pt-4 border-t border-grid-border flex items-center justify-between font-mono text-xs">
                <span class="text-editorial-gray text-[11px] uppercase">{article.data.date}</span>
                <a href={url(`/journal/${article.slug}`)} class="inline-flex items-center gap-1 font-bold text-editorial-ink group-hover:text-editorial-red transition-colors uppercase tracking-widest">
                  <span>READ DISPATCH</span>
                  <span class="material-symbols-outlined text-xs transition-transform group-hover:translate-x-0.5">arrow_forward</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>
  </div>

  <script>
    // Client-side category filtering
    const buttons = document.querySelectorAll('.journal-filter-btn');
    const cards = document.querySelectorAll('.journal-card');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');
        
        buttons.forEach((b) => {
          b.classList.remove('bg-editorial-ink', 'text-white');
          b.classList.add('bg-canvas-warm', 'text-editorial-ink');
        });
        btn.classList.remove('bg-canvas-warm', 'text-editorial-ink');
        btn.classList.add('bg-editorial-ink', 'text-white');

        cards.forEach((card) => {
          const cat = card.getAttribute('data-category');
          if (filter === 'all' || cat === filter) {
            (card as HTMLElement).style.display = 'flex';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  </script>
</BaseLayout>
