---
import BaseLayout from '../layouts/BaseLayout.astro';

const rawBase = import.meta.env.BASE_URL || "";
const base = rawBase.replace(/\/$/, "");
const url = (p: string) => `${base}${p.startsWith('/') ? p : '/' + p}`;
---

<BaseLayout
  title="MODEL COMP-CARD (ZED CARD) — Atharva Sharma // Digital & Print Package"
  description="Official composite card (zed card) for Atharva Sharma conforming to international modeling agency standards. 6'1&quot; (186cm), print-ready A5 format."
  keywords="model comp card, zed card India, Atharva Sharma comp card, printable model composite card, male model z-card"
  ogImage="assets/images/atharva-studio-bw-stool.png"
>
<style>
  @media print {
    header, footer, .no-print {
      display: none !important;
    }
    body {
      background: #FFFFFF !important;
      color: #000000 !important;
      padding: 0 !important;
      margin: 0 !important;
    }
    .comp-card-container {
      max-width: 100% !important;
      margin: 0 !important;
      box-shadow: none !important;
      border: 1px solid #000 !important;
      page-break-inside: avoid;
    }
    .print-page-break {
      page-break-after: always;
    }
  }
</style>

<!-- ACTION BAR (NO-PRINT) -->
<section class="no-print w-full bg-canvas-warm border-b border-grid-border px-4 sm:px-8 py-3">
  <div class="max-w-5xl mx-auto flex flex-wrap items-center justify-between gap-3 font-mono text-xs">
    <div class="flex items-center gap-2">
      <span class="w-2.5 h-2.5 bg-editorial-red inline-block"></span>
      <span class="text-editorial-ink font-bold uppercase">MODEL COMPOSITE CARD // ZED CARD</span>
      <span class="text-editorial-gray hidden sm:inline">• SPECIFICATION: SS26 DIRECT BOARD</span>
    </div>
    <div class="flex items-center gap-2 sm:gap-3 w-full sm:w-auto">
      <button onclick="window.print()" class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-1.5 px-5 py-2.5 bg-editorial-red text-white hover:bg-editorial-ink transition-colors font-mono text-xs tracking-widest uppercase font-bold shadow-sm min-h-[44px]">
        <span class="material-symbols-outlined text-[16px]">print</span>
        <span>PRINT / SAVE PDF</span>
      </button>
      <a href={url("/contact")} class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-1.5 px-5 py-2.5 bg-canvas-sheet text-editorial-ink hover:bg-editorial-ink hover:text-white transition-colors font-mono text-xs tracking-widest uppercase font-bold min-h-[44px]">
        <span>BOOK TALENT</span>
        <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
      </a>
    </div>
  </div>
</section>

<!-- COMP-CARD DOCUMENT CONTAINER -->
<div class="w-full bg-canvas-alt px-3 sm:px-8 py-6 sm:py-10">
  <div class="comp-card-container max-w-5xl mx-auto bg-white border-2 border-editorial-ink shadow-xl p-4 sm:p-8">
    
    <!-- COMP CARD HEADER -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between border-b-2 border-editorial-ink pb-4 mb-6 gap-2 sm:gap-4">
      <div>
        <span class="font-mono text-xs text-editorial-red uppercase font-bold tracking-widest block">DIRECT TALENT BOARD // UDAIPUR • INDIA</span>
        <h1 class="font-display text-4xl sm:text-6xl text-editorial-ink uppercase tracking-tight leading-none">ATHARVA SHARMA</h1>
      </div>
      <div class="font-mono text-xs text-editorial-gray sm:text-right flex flex-col gap-0.5">
        <span class="text-editorial-ink font-bold uppercase">RUNWAY &amp; EDITORIAL MENSWEAR</span>
        <span>HEIGHT: 6'1" // 186CM</span>
        <span>LOCATION: UDAIPUR / WORLDWIDE COMMISSIONS</span>
      </div>
    </div>

    <!-- DOUBLE-SIDED GRID PRESENTATION -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch mb-6">
      
      <!-- FRONT SIDE: HERO LEAD SHOT -->
      <div class="lg:col-span-5 flex flex-col border border-editorial-ink p-2 bg-canvas-warm">
        <div class="relative w-full aspect-[3/4] overflow-hidden group bg-editorial-ink">
          <img src={url("/assets/images/atharva-studio-bw-stool.png")} alt="Atharva Sharma studio portrait" class="w-full h-full object-cover object-top grayscale contrast-115 transition-all duration-500 group-hover:grayscale-0">
          <div class="absolute top-2 left-2 bg-editorial-ink text-white font-mono text-[10px] px-2 py-0.5 uppercase tracking-widest">
            A-SIDE // HERO STUDIO PORTRAIT
          </div>
          <div class="absolute bottom-2 left-2 right-2 bg-editorial-ink/90 text-white font-mono text-[10px] px-2 py-1 flex justify-between">
            <span>STUDIO DIRECT</span>
            <span>6'1" / 186CM</span>
          </div>
        </div>
        <div class="p-2 pt-3 flex justify-between items-center font-mono text-xs">
          <span class="font-bold text-editorial-ink uppercase">ATHARVA SHARMA</span>
          <span class="text-editorial-red font-bold">HAZEL / DARK BROWN</span>
        </div>
      </div>

      <!-- REVERSE SIDE: 4-LOOK EDITORIAL QUAD -->
      <div class="lg:col-span-7 flex flex-col justify-between border border-editorial-ink p-2 bg-canvas-warm">
        <div class="flex items-center justify-between px-2 py-1 border-b border-grid-border mb-2">
          <span class="font-mono text-[10px] font-bold text-editorial-ink uppercase">B-SIDE // EDITORIAL RANGE QUAD</span>
          <span class="font-mono text-[10px] text-editorial-gray uppercase">4 DISTINCT LOOK SPECIMENS</span>
        </div>
        
        <div class="grid grid-cols-2 gap-2 flex-grow">
          <!-- Quad Look 1: Ethnic Heritage -->
          <div class="relative aspect-[3/4] bg-canvas-sheet overflow-hidden group border border-grid-border">
            <img src={url("/assets/images/atharva-kurta-palace-night.jpg")} alt="Atharva Sharma royal velvet kurta" class="w-full h-full object-cover grayscale contrast-110 group-hover:grayscale-0 transition-all duration-500">
            <div class="absolute bottom-0 inset-x-0 bg-editorial-ink/85 text-white font-mono text-[9px] px-1.5 py-0.5 flex justify-between uppercase">
              <span>01. ETHNIC HERITAGE</span>
              <span>UDAIPUR PALACE</span>
            </div>
          </div>

          <!-- Quad Look 2: Monolith Desert -->
          <div class="relative aspect-[3/4] bg-canvas-sheet overflow-hidden group border border-grid-border">
            <img src={url("/assets/images/atharva-desert-jeep-bw.jpg")} alt="Atharva Sharma Thar desert expedition" class="w-full h-full object-cover grayscale contrast-115 group-hover:grayscale-0 transition-all duration-500">
            <div class="absolute bottom-0 inset-x-0 bg-editorial-ink/85 text-white font-mono text-[9px] px-1.5 py-0.5 flex justify-between uppercase">
              <span>02. EXPEDITION</span>
              <span>THAR DESERT</span>
            </div>
          </div>

          <!-- Quad Look 3: Coastal Motion -->
          <div class="relative aspect-[3/4] bg-canvas-sheet overflow-hidden group border border-grid-border">
            <img src={url("/assets/images/atharva-horse-beach.jpg")} alt="Atharva Sharma coastal equestrian" class="w-full h-full object-cover grayscale contrast-110 group-hover:grayscale-0 transition-all duration-500">
            <div class="absolute bottom-0 inset-x-0 bg-editorial-ink/85 text-white font-mono text-[9px] px-1.5 py-0.5 flex justify-between uppercase">
              <span>03. RESORT EQUINE</span>
              <span>COASTLINE</span>
            </div>
          </div>

          <!-- Quad Look 4: European Tailored -->
          <div class="relative aspect-[3/4] bg-canvas-sheet overflow-hidden group border border-grid-border">
            <img src={url("/assets/images/atharva-citynight-scarf.jpg")} alt="Atharva Sharma European city night" class="w-full h-full object-cover grayscale contrast-115 group-hover:grayscale-0 transition-all duration-500">
            <div class="absolute bottom-0 inset-x-0 bg-editorial-ink/85 text-white font-mono text-[9px] px-1.5 py-0.5 flex justify-between uppercase">
              <span>04. NOCTURNAL TAILORED</span>
              <span>CENTRAL EUROPE</span>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- STATS & MEASUREMENTS TABLE -->
    <div class="border-2 border-editorial-ink p-4 mb-6 bg-canvas-sheet">
      <div class="flex items-center justify-between border-b border-grid-border pb-2 mb-3">
        <span class="font-display text-lg sm:text-xl uppercase text-editorial-ink">OFFICIAL PHYSICAL SPECIFICATIONS</span>
        <span class="font-mono text-xs text-editorial-red uppercase font-bold">CALIBRATED SS26</span>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-2 text-center font-mono">
        <div class="p-2 bg-white border border-grid-border">
          <span class="text-[10px] text-editorial-gray block uppercase">HEIGHT</span>
          <span class="font-bold text-editorial-ink text-xs sm:text-sm block">6'1" / 186CM</span>
        </div>
        <div class="p-2 bg-white border border-grid-border">
          <span class="text-[10px] text-editorial-gray block uppercase">CHEST</span>
          <span class="font-bold text-editorial-ink text-xs sm:text-sm block">38" / 96CM</span>
        </div>
        <div class="p-2 bg-white border border-grid-border">
          <span class="text-[10px] text-editorial-gray block uppercase">WAIST</span>
          <span class="font-bold text-editorial-ink text-xs sm:text-sm block">30" / 76CM</span>
        </div>
        <div class="p-2 bg-white border border-grid-border">
          <span class="text-[10px] text-editorial-gray block uppercase">SHOES</span>
          <span class="font-bold text-editorial-ink text-xs sm:text-sm block">43 EU / 10 US</span>
        </div>
        <div class="p-2 bg-white border border-grid-border">
          <span class="text-[10px] text-editorial-gray block uppercase">HAIR</span>
          <span class="font-bold text-editorial-ink text-xs sm:text-sm block">DARK BROWN</span>
        </div>
        <div class="p-2 bg-white border border-grid-border">
          <span class="text-[10px] text-editorial-gray block uppercase">EYES</span>
          <span class="font-bold text-editorial-ink text-xs sm:text-sm block">HAZEL</span>
        </div>
        <div class="p-2 bg-white border border-grid-border">
          <span class="text-[10px] text-editorial-gray block uppercase">COLLAR</span>
          <span class="font-bold text-editorial-ink text-xs sm:text-sm block">15.5" / 39CM</span>
        </div>
        <div class="p-2 bg-white border border-grid-border">
          <span class="text-[10px] text-editorial-gray block uppercase">SUIT SIZE</span>
          <span class="font-bold text-editorial-ink text-xs sm:text-sm block">38R // 48 EU</span>
        </div>
      </div>
    </div>

    <!-- BOOKING CONTACT BAR -->
    <div class="bg-editorial-ink text-white p-4 sm:p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex flex-col text-center sm:text-left">
        <span class="font-mono text-[10px] text-editorial-red uppercase font-bold tracking-widest">DIRECT CASTING CORRESPONDENCE</span>
        <span class="font-display text-xl sm:text-2xl uppercase tracking-tight">ATHARVA SHARMA // DIRECT BOOK</span>
      </div>
      <div class="flex flex-wrap items-center justify-center sm:justify-end gap-3 sm:gap-4 font-mono text-xs">
        <a href="mailto:atharva@atharvasharma.co.in" class="hover:text-editorial-red transition-colors">
          atharva@atharvasharma.co.in
        </a>
        <span class="text-editorial-gray hidden sm:inline">•</span>
        <a href="https://wa.me/918209225998" target="_blank" rel="noopener noreferrer" class="hover:text-editorial-red transition-colors">
          +91 8209225998
        </a>
        <span class="text-editorial-gray hidden sm:inline">•</span>
        <a href="https://www.instagram.com/atharvasharma.co.in" target="_blank" rel="noopener noreferrer" class="text-editorial-red hover:underline flex items-center gap-1">
          <span>@atharvasharma.co.in</span>
          <span class="material-symbols-outlined text-[14px]">arrow_outward</span>
        </a>
      </div>
    </div>

  </div>
</div>
</BaseLayout>
