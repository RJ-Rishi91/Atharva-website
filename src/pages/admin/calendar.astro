---
// src/pages/admin/calendar.astro
// Editorial Publishing Calendar — Atharva Sharma CMS
import '../../styles/global.css';

const rawBase = import.meta.env.BASE_URL || "";
const base = rawBase.replace(/\/$/, "");
const url = (p: string) => `${base}${p.startsWith('/') ? p : '/' + p}`;
---

<!DOCTYPE html>
<html lang="en" class="bg-[#FBF9F6]">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Editorial Calendar // ATHARVA SHARMA CMS</title>
  <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
  <meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@300;400;500;600;700&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
  <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />

  <style>
    :root {
      --canvas-warm: #FBF9F6;
      --canvas-sheet: #FFFFFF;
      --canvas-alt: #F5F2EB;
      --ink: #1B1B1B;
      --red: #D72626;
      --red-deep: #B31F1F;
      --gray: #767676;
      --grid-border: #E5E0D8;
    }
    body {
      background-color: var(--canvas-warm);
      color: var(--ink);
      font-family: 'Inter', sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    .font-display {
      font-family: 'Anton', sans-serif;
    }
    .font-mono {
      font-family: 'Space Mono', monospace;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col selection:bg-[#D72626] selection:text-white">

  <!-- Header -->
  <header class="w-full border-b border-[#E5E0D8] bg-[#F5F2EB] sticky top-0 z-30">
    <div class="max-w-[1780px] mx-auto px-4 sm:px-8 h-16 flex items-center justify-between">
      
      <div class="flex items-center gap-4">
        <a href={url('/admin')} class="flex items-center gap-2 group">
          <span class="w-2.5 h-2.5 bg-[#D72626]"></span>
          <span class="font-display text-xl tracking-tight text-[#1B1B1B] uppercase group-hover:text-[#D72626] transition-colors">
            ATHARVA SHARMA
          </span>
          <span class="font-mono text-xs text-[#767676] hidden sm:inline">// CMS DESK</span>
        </a>

        <nav class="hidden md:flex items-center gap-1 font-mono text-xs uppercase tracking-wider ml-6 pl-6 border-l border-[#E5E0D8]">
          <a href={url('/admin')} class="px-3 py-1.5 text-[#767676] hover:text-[#1B1B1B] hover:bg-[#E5E0D8]/60 transition-colors">
            DISPATCHES
          </a>
          <a href={url('/admin/calendar')} class="px-3 py-1.5 bg-[#1B1B1B] text-white font-bold">
            CALENDAR
          </a>
          <a href={url('/journal')} target="_blank" class="px-3 py-1.5 text-[#767676] hover:text-[#D72626] transition-colors flex items-center gap-1">
            <span>LIVE JOURNAL</span>
            <span class="material-symbols-outlined text-[14px]">open_in_new</span>
          </a>
        </nav>
      </div>

      <div class="flex items-center gap-3">
        <a
          href={url('/admin/editor')}
          class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-[#D72626] hover:bg-[#B31F1F] text-white font-mono text-xs uppercase tracking-wider font-bold transition-colors shadow-sm"
        >
          <span class="material-symbols-outlined text-[16px]">add</span>
          <span>NEW DISPATCH</span>
        </a>

        <button
          type="button"
          id="logoutBtn"
          class="p-2 text-[#767676] hover:text-[#D72626] transition-colors"
          title="Logout"
        >
          <span class="material-symbols-outlined text-[20px]">logout</span>
        </button>
      </div>

    </div>
  </header>

  <!-- Main Calendar View -->
  <main class="w-full flex-1 max-w-[1780px] mx-auto px-4 sm:px-8 py-8 flex flex-col gap-6">

    <!-- Calendar Month Controls -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-[#E5E0D8]">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="font-mono text-xs text-[#D72626] uppercase tracking-widest font-bold">[ 02 // TIMELINE SCHEDULE ]</span>
          <span class="text-[#767676] text-xs">•</span>
          <span class="font-mono text-xs text-[#767676] tracking-widest uppercase">AUTOMATED AP-SCHEDULER ENGINE</span>
        </div>
        <h1 id="currentMonthYearLabel" class="font-display text-3xl sm:text-5xl uppercase tracking-tight text-[#1B1B1B] leading-none m-0">
          CALENDAR
        </h1>
      </div>

      <!-- Month Stepper -->
      <div class="flex items-center gap-2 font-mono text-xs">
        <button
          type="button"
          id="prevMonthBtn"
          class="p-2 bg-white border border-[#E5E0D8] hover:bg-[#F5F2EB] text-[#1B1B1B] transition-colors"
          title="Previous Month"
        >
          <span class="material-symbols-outlined text-[18px]">chevron_left</span>
        </button>

        <button
          type="button"
          id="todayBtn"
          class="px-3 py-2 bg-white border border-[#E5E0D8] hover:bg-[#F5F2EB] text-[#1B1B1B] font-bold uppercase tracking-wider"
        >
          TODAY
        </button>

        <button
          type="button"
          id="nextMonthBtn"
          class="p-2 bg-white border border-[#E5E0D8] hover:bg-[#F5F2EB] text-[#1B1B1B] transition-colors"
          title="Next Month"
        >
          <span class="material-symbols-outlined text-[18px]">chevron_right</span>
        </button>
      </div>
    </div>

    <!-- Calendar Grid Container -->
    <div class="bg-white border border-[#E5E0D8] shadow-sm overflow-hidden flex flex-col">
      
      <!-- Day-of-week header -->
      <div class="grid grid-cols-7 bg-[#F5F2EB] border-b border-[#E5E0D8] font-mono text-[11px] text-[#767676] uppercase tracking-wider text-center py-2.5 font-bold">
        <div>MON</div>
        <div>TUE</div>
        <div>WED</div>
        <div>THU</div>
        <div>FRI</div>
        <div>SAT</div>
        <div>SUN</div>
      </div>

      <!-- Days Grid -->
      <div id="calendarGrid" class="grid grid-cols-7 border-collapse divide-x divide-y divide-[#E5E0D8] min-h-[600px]">
        <!-- Injected via JS -->
      </div>

    </div>

  </main>

  <script is:inline define:vars={{ base }}>
    // Auth Check
    const token = sessionStorage.getItem('ath_token');
    if (!token) {
      window.location.href = `${base}/admin/login`;
    }

    const DEFAULT_API = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1'
      ? 'http://localhost:8000'
      : 'https://atharva-api.onrender.com';
    const API_URL = (localStorage.getItem('ath_api_url') || DEFAULT_API).replace(/\/$/, '');

    const calendarGrid = document.getElementById('calendarGrid');
    const currentMonthYearLabel = document.getElementById('currentMonthYearLabel');
    const prevMonthBtn = document.getElementById('prevMonthBtn');
    const nextMonthBtn = document.getElementById('nextMonthBtn');
    const todayBtn = document.getElementById('todayBtn');
    const logoutBtn = document.getElementById('logoutBtn');

    logoutBtn.addEventListener('click', () => {
      sessionStorage.removeItem('ath_token');
      window.location.href = `${base}/admin/login`;
    });

    let currentDate = new Date();
    let allPosts = [];

    async function loadPosts() {
      try {
        const res = await fetch(`${API_URL}/api/admin/posts`, {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        if (res.status === 401) {
          sessionStorage.removeItem('ath_token');
          window.location.href = `${base}/admin/login`;
          return;
        }
        if (res.ok) {
          allPosts = await res.json();
          renderCalendar();
        }
      } catch (err) {
        console.error('Calendar posts fetch error:', err);
      }
    }

    function renderCalendar() {
      const year = currentDate.getFullYear();
      const month = currentDate.getMonth();

      const monthNames = [
        'JANUARY', 'FEBRUARY', 'MARCH', 'APRIL', 'MAY', 'JUNE',
        'JULY', 'AUGUST', 'SEPTEMBER', 'OCTOBER', 'NOVEMBER', 'DECEMBER'
      ];
      currentMonthYearLabel.textContent = `${monthNames[month]} ${year}`;

      const firstDayOfMonth = new Date(year, month, 1);
      const daysInMonth = new Date(year, month + 1, 0).getDate();

      // Convert day of week so Monday is 0, Sunday is 6
      let startDay = firstDayOfMonth.getDay() - 1;
      if (startDay === -1) startDay = 6;

      calendarGrid.innerHTML = '';

      // Blank prefix cells for previous month
      for (let i = 0; i < startDay; i++) {
        const cell = document.createElement('div');
        cell.className = 'bg-[#FBF9F6]/40 p-2 min-h-[110px] text-right text-[#E5E0D8] font-mono text-xs select-none';
        calendarGrid.appendChild(cell);
      }

      const today = new Date();
      const isCurrentMonth = today.getFullYear() === year && today.getMonth() === month;

      for (let d = 1; d <= daysInMonth; d++) {
        const cellDate = new Date(year, month, d);
        const dateStr = `${year}-${String(month + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
        const isToday = isCurrentMonth && today.getDate() === d;

        // Find posts on this date
        const matchingPosts = allPosts.filter(p => {
          if (p.status === 'published' && p.published_at) {
            return p.published_at.startsWith(dateStr);
          }
          if (p.status === 'scheduled' && p.scheduled_at) {
            return p.scheduled_at.startsWith(dateStr);
          }
          return false;
        });

        const cell = document.createElement('div');
        cell.className = `p-2 min-h-[110px] flex flex-col justify-between transition-colors hover:bg-[#FBF9F6] ${isToday ? 'bg-amber-50/40' : 'bg-white'}`;

        const topRow = `
          <div class="flex items-center justify-between font-mono text-xs mb-1">
            <span class="${isToday ? 'px-1.5 py-0.5 bg-[#D72626] text-white font-bold rounded-xs' : 'text-[#767676]'}">
              ${d}
            </span>
            ${matchingPosts.length > 0 ? `<span class="w-1.5 h-1.5 rounded-full bg-[#D72626]"></span>` : ''}
          </div>
        `;

        const postsHtml = matchingPosts.map(p => {
          const isPub = p.status === 'published';
          const bg = isPub ? 'bg-[#ECFDF5] text-[#065F46] border-[#A7F3D0]' : 'bg-[#FFFBEB] text-[#92400E] border-[#FDE68A]';
          return `
            <a href="${base}/admin/editor?id=${p.id}" class="block text-[10px] font-mono p-1 border ${bg} rounded-xs mb-1 truncate hover:opacity-80 transition-opacity" title="${p.title}">
              ${isPub ? '✓' : '⏰'} ${p.title}
            </a>
          `;
        }).join('');

        cell.innerHTML = `
          <div>
            ${topRow}
            <div class="space-y-1 mt-1 overflow-hidden">
              ${postsHtml}
            </div>
          </div>
        `;

        calendarGrid.appendChild(cell);
      }
    }

    prevMonthBtn.addEventListener('click', () => {
      currentDate.setMonth(currentDate.getMonth() - 1);
      renderCalendar();
    });

    nextMonthBtn.addEventListener('click', () => {
      currentDate.setMonth(currentDate.getMonth() + 1);
      renderCalendar();
    });

    todayBtn.addEventListener('click', () => {
      currentDate = new Date();
      renderCalendar();
    });

    loadPosts();
  </script>
</body>
</html>
