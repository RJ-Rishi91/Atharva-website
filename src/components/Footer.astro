---
const rawBase = import.meta.env.BASE_URL || "";
const base = rawBase.replace(/\/$/, "");
const url = (p: string) => `${base}${p.startsWith('/') ? p : '/' + p}`;
---

<!-- ==================== FOOTER & BOOKINGS REGISTER ==================== -->
<footer class="w-full bg-editorial-ink text-canvas-warm py-16 sm:py-20 px-4 sm:px-8 border-t border-grid-border mt-auto" id="contact">
  <div class="max-w-[1780px] mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 sm:gap-12">
    <!-- Column 1: Brand & Editorial Identity -->
    <div class="lg:col-span-5 space-y-6">
      <div class="flex items-center gap-3">
        <div class="w-3.5 h-3.5 bg-editorial-red"></div>
        <span class="font-display text-2xl sm:text-3xl tracking-wider text-white uppercase">ATHARVA SHARMA</span>
      </div>
      <p class="font-sans text-sm text-canvas-warm/75 max-w-md leading-relaxed">
        Udaipur native available internationally for fashion editorials, runway presentations, global luxury campaigns, and brand partnerships. Representing a refined South Asian aesthetic with contemporary international versatility.
      </p>
      <div class="font-mono text-xs tracking-widest text-editorial-red font-bold">
        SS26 / FW26 COMMISSIONS &amp; CASTINGS NOW OPEN
      </div>
    </div>

    <!-- Column 2: Direct Inquiries & Agency Details -->
    <div class="lg:col-span-4 space-y-3 font-mono text-xs tracking-widest uppercase">
      <div class="text-canvas-warm/40 pb-2 border-b border-white/15">DIRECT INQUIRIES &amp; AGENTS</div>
      <a class="block text-base font-bold text-white hover:text-editorial-red transition-colors" href="mailto:atharva@atharvasharma.co.in">
        atharva@atharvasharma.co.in
      </a>
      <a class="block text-canvas-warm/80 hover:text-white transition-colors" href="https://wa.me/918209225998" target="_blank" rel="noopener noreferrer">
        +91 8209225998 // WHATSAPP DIRECT
      </a>
      <a class="block text-canvas-warm/80 hover:text-editorial-red transition-colors" href="https://www.instagram.com/atharvasharma.co.in" target="_blank" rel="noopener noreferrer">
        INSTAGRAM: @ATHARVASHARMA.CO.IN
      </a>
      <div class="text-canvas-warm/60 pt-2">
        TIMEZONE: IST (UTC+5:30) &bull; WORLDWIDE TRAVEL READY
      </div>
    </div>

    <!-- Column 3: Physical Specs Summary -->
    <div class="lg:col-span-3 space-y-3 font-mono text-xs tracking-widest uppercase">
      <div class="text-canvas-warm/40 pb-2 border-b border-white/15">PHYSICAL SPECS &amp; BOARD</div>
      <div class="text-canvas-warm/80">HEIGHT: 6'1" / 186CM</div>
      <div class="text-canvas-warm/80">CHEST: 38" | WAIST: 30" | SHOES: 43 EU</div>
      <div class="text-white font-medium">LOCATION: UDAIPUR / MUMBAI / DELHI</div>
      <div class="text-editorial-red font-bold pt-2">ALL RIGHTS RESERVED &copy; 2026 ATHARVA SHARMA</div>
    </div>
  </div>

  <!-- Full Editorial Navigation Directory Strip -->
  <div class="max-w-[1780px] mx-auto mt-12 pt-8 border-t border-white/15 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 font-mono text-xs uppercase tracking-widest">
    <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-canvas-warm/75">
      <a href={url('/')} class="hover:text-white transition-colors">01. HOME</a>
      <a href={url('/digitals')} class="hover:text-white transition-colors">02. DIGITALS</a>
      <a href={url('/portfolio')} class="hover:text-white transition-colors">03. PORTFOLIO</a>
      <a href={url('/stats')} class="hover:text-white transition-colors">04. STATS</a>
      <a href={url('/about')} class="hover:text-white transition-colors">05. ABOUT</a>
      <a href={url('/journal')} class="hover:text-white transition-colors">06. JOURNAL</a>
      <a href={url('/comp-card')} class="hover:text-editorial-red font-bold transition-colors">COMP-CARD</a>
      <a href={url('/contact')} class="hover:text-white transition-colors">07. CONTACT</a>
    </div>
    <div class="text-canvas-warm/40 text-[10px]">
      RUNWAY &amp; EDITORIAL PORTFOLIO // VERIFIED MODEL DESK
    </div>
  </div>
</footer>
